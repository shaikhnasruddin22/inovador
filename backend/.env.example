# ==============================================================================
# INOVADOR DESIGN STUDIO — STRAPI V5 CMS PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================
# Configure these variables in your managed persistent Node.js host (Railway/Render/VPS)

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=1337
APP_KEYS=random_key_1,random_key_2,random_key_3,random_key_4
API_TOKEN_SALT=random_salt_for_api_tokens
ADMIN_JWT_SECRET=random_jwt_secret_for_admin_panel
TRANSFER_TOKEN_SALT=random_salt_for_transfer_tokens
JWT_SECRET=random_jwt_secret_for_users_permissions

# Public domain where Strapi is hosted
PUBLIC_URL=https://cms.yourdomain.com

# Allowed frontend origin(s) for CORS (comma-separated or single domain)
FRONTEND_URL=https://www.yourdomain.com

# ------------------------------------------------------------------------------
# 2. PERSISTENT MYSQL DATABASE
# ------------------------------------------------------------------------------
DATABASE_CLIENT=mysql
DATABASE_HOST=your_production_mysql_host.example.com
DATABASE_PORT=3306
DATABASE_NAME=inovador_cms
DATABASE_USERNAME=your_production_db_user
DATABASE_PASSWORD=your_secure_db_password
DATABASE_SSL=false

# ------------------------------------------------------------------------------
# 3. CLOUDINARY MEDIA CDN STORAGE
# ------------------------------------------------------------------------------
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 4. REVALIDATION WEBHOOK
# ------------------------------------------------------------------------------
REVALIDATE_SECRET=your_long_random_revalidation_secret_key_here
