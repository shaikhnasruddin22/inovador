# ==============================================================================
# INOVADOR DESIGN STUDIO — FRONTEND PRODUCTION & PREVIEW ENVIRONMENT VARIABLES
# ==============================================================================
# All variables below must be configured in Vercel Project Settings:
# https://vercel.com/docs/projects/environment-variables

# ------------------------------------------------------------------------------
# 1. CORE NEXT.JS & CMS CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------
# The public or private URL of your persistent Strapi v5 instance.
# Production Example: https://cms.inovadordesign.com
# Local Dev Default: http://localhost:1337
STRAPI_API_URL=https://cms.yourdomain.com

# Server-side API Read Token generated in Strapi Admin > Settings > API Tokens (Read-Only)
# CRITICAL: Keep server-side only. NEVER prefix with NEXT_PUBLIC_.
STRAPI_READ_TOKEN=your_strapi_read_token_here

# Server-side API Write Token for saving inquiries (Custom / Inquiries: Create)
# CRITICAL: Keep server-side only. NEVER prefix with NEXT_PUBLIC_.
STRAPI_WRITE_TOKEN=your_strapi_write_token_here

# Production Canonical Base URL for SEO & Sitemaps
# Example: https://www.inovadordesign.com
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com

# Content Source Flag. MUST be false in Production.
USE_MOCK_DATA=false

# ------------------------------------------------------------------------------
# 2. ISR REVALIDATION & WEBHOOKS
# ------------------------------------------------------------------------------
# Secret key shared between Strapi Webhooks and Next.js /api/revalidate route.
REVALIDATE_SECRET=your_long_random_revalidation_secret_key_here

# ------------------------------------------------------------------------------
# 3. EMAIL DISPATCH (RESEND)
# ------------------------------------------------------------------------------
# Resend API Key from https://resend.com/api-keys
# CRITICAL: Keep server-side only. NEVER prefix with NEXT_PUBLIC_.
RESEND_API_KEY=re_your_resend_api_key_here

# Verified sender email address configured and verified in Resend domain settings
# Example: Inovador Studio <briefs@inovadordesign.com>
RESEND_FROM_EMAIL=Inovador Briefs <briefs@yourdomain.com>

# Destination studio inbox receiving client briefs
STUDIO_NOTIFICATION_EMAIL=studio@yourdomain.com

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE TURNSTILE (BOT PROTECTION)
# ------------------------------------------------------------------------------
# Public Site Key used by browser widget in InquiryForm
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAAA_your_public_site_key

# Secret Key used server-side in /api/inquiry to verify challenge responses
# CRITICAL: Keep server-side only. NEVER prefix with NEXT_PUBLIC_.
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAAA_your_private_secret_key
